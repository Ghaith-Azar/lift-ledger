# Copy this file to .env for local development (never commit the real .env).

# --- Database ---
# Leave both blank to use a local SQLite file (./local.db) for development.
# For production, create a database at https://turso.tech and fill these in:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Access ---
# The whole app is behind this one password (there's only one user: you).
# Required in production — the server refuses to start without it.
APP_PASSWORD=

# Optional: used to sign the login cookie. If you leave it blank, one is
# derived from APP_PASSWORD automatically, which is fine for a single-user
# app. Set your own random string if you'd rather be explicit.
SESSION_SECRET=

# --- Weekly weigh-in reminders (optional) ---
# Push notifications work without these too — the in-app reminder banner on
# the Train tab needs nothing. These three unlock actual phone/browser
# notifications. Generate them with: npm run vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional: lets an external scheduler (since Render's free tier sleeps when
# idle, an in-process timer alone isn't reliable) trigger the weekly check by
# calling POST /api/push/trigger?secret=... — see the README. Leave blank to
# rely only on the in-process timer, which only helps if your instance
# doesn't sleep.
CRON_SECRET=

# Set automatically by Render; only needed locally if you want a non-default port.
PORT=3000
